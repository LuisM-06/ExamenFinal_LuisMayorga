@page "/productos"
@rendermode InteractiveServer
@using ExamenFinal_LuisMayorga.Models
@using ExamenFinal_LuisMayorga.Services
@inject ProductoService ProductoService

<h3>Sistema de Gestión de Pedidos en un Restaurante</h3>

<hr />

<h4>Ingreso de nuevo producto</h4>

<div class="mb-3">
    <label>Tipo de producto:</label>
    <select class="form-select" @bind="tipoProducto">
        <option value="">Seleccione un tipo</option>
        <option value="Bebida">Bebida</option>
        <option value="PlatoFuerte">Plato fuerte</option>
        <option value="Postre">Postre</option>
    </select>
</div>

<div class="mb-3">
    <label>Código único:</label>
    <input class="form-control" @bind="codigo" />
</div>

<div class="mb-3">
    <label>Nombre:</label>
    <input class="form-control" @bind="nombre" />
</div>

<div class="mb-3">
    <label>Precio base:</label>
    <input class="form-control" type="number" step="0.01" @bind="precioBase" />
</div>

@if (tipoProducto == "Bebida")
{
    <h5>Datos de la bebida</h5>

    <div class="mb-3">
        <label>Volumen en ml:</label>
        <input class="form-control" type="number" @bind="volumenMl" />
    </div>

    <div class="mb-3">
        <label>Tipo de bebida:</label>
        <select class="form-select" @bind="tipoBebida">
            <option value="">Seleccione</option>
            <option value="Refresco">Refresco</option>
            <option value="Cerveza">Cerveza</option>
            <option value="Agua">Agua</option>
        </select>
    </div>
}

@if (tipoProducto == "PlatoFuerte")
{
    <h5>Datos del plato fuerte</h5>

    <div class="mb-3">
        <label>Tipo de carne:</label>
        <select class="form-select" @bind="tipoCarne">
            <option value="">Seleccione</option>
            <option value="Res">Res</option>
            <option value="Pollo">Pollo</option>
            <option value="Pescado">Pescado</option>
            <option value="Vegetariano">Vegetariano</option>
        </select>
    </div>

    <div class="mb-3">
        <label>Acompañamiento:</label>
        <select class="form-select" @bind="acompanamiento">
            <option value="">Seleccione</option>
            <option value="Papas">Papas</option>
            <option value="Arroz">Arroz</option>
            <option value="Ensalada">Ensalada</option>
        </select>
    </div>
}

@if (tipoProducto == "Postre")
{
    <h5>Datos del postre</h5>

    <div class="mb-3">
        <label>
            <input type="checkbox" @bind="contieneAzucar" />
            ¿Contiene azúcar?
        </label>
    </div>

    <div class="mb-3">
        <label>Porción:</label>
        <select class="form-select" @bind="porcion">
            <option value="">Seleccione</option>
            <option value="Individual">Individual</option>
            <option value="Compartir">Compartir</option>
        </select>
    </div>
}

<button class="btn btn-primary" @onclick="GuardarProducto">Guardar producto</button>

@if (!string.IsNullOrWhiteSpace(mensaje))
{
    <p class="mt-3">@mensaje</p>
}

<hr />

<h4>Búsqueda de productos</h4>

<div class="mb-3">
    <label>Criterio de búsqueda:</label>
    <select class="form-select" @bind="criterioBusqueda">
        <option value="Todos">Mostrar todos</option>
        <option value="Codigo">Código</option>
        <option value="Nombre">Nombre</option>
        <option value="Tipo">Tipo de producto</option>
    </select>
</div>

<div class="mb-3">
    <label>Texto de búsqueda:</label>
    <input class="form-control" @bind="textoBusqueda" placeholder="Ejemplo: bebida, agua, P001..." />
</div>

<button class="btn btn-secondary" @onclick="BuscarProductos">Buscar</button>
<button class="btn btn-outline-secondary ms-2" @onclick="MostrarTodos">Mostrar todos</button>

@if (!string.IsNullOrWhiteSpace(mensajeBusqueda))
{
    <p class="mt-3">@mensajeBusqueda</p>
}

<hr />

<h4>Listado de productos</h4>

<p>
    <strong>Total de productos en el inventario:</strong> @totalProductos
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Tipo</th>
            <th>Código</th>
            <th>Nombre</th>
            <th>Precio base</th>
            <th>Datos específicos</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var producto in productosMostrados)
        {
            <tr>
                <td>@ObtenerTipo(producto)</td>
                <td>@producto.Codigo</td>
                <td>@producto.Nombre</td>
                <td>Q @producto.PrecioBase</td>
                <td>@ObtenerDatosEspecificos(producto)</td>
            </tr>
        }
    </tbody>
</table>

@code {
    string tipoProducto = "";

    string codigo = "";
    string nombre = "";
    decimal precioBase;

    int volumenMl;
    string tipoBebida = "";

    string tipoCarne = "";
    string acompanamiento = "";

    bool contieneAzucar;
    string porcion = "";

    string mensaje = "";

    string criterioBusqueda = "Todos";
    string textoBusqueda = "";
    string mensajeBusqueda = "";

    List<Producto> productosMostrados = new List<Producto>();
    int totalProductos = 0;

    protected override void OnInitialized()
    {
        CargarListado();
    }

    void GuardarProducto()
    {
        mensaje = "";
        mensajeBusqueda = "";

        if (string.IsNullOrWhiteSpace(tipoProducto))
        {
            mensaje = "Debe seleccionar el tipo de producto.";
            return;
        }

        if (string.IsNullOrWhiteSpace(codigo))
        {
            mensaje = "Debe ingresar el código único del producto.";
            return;
        }

        if (ProductoService.ExisteCodigo(codigo))
        {
            mensaje = "Ya existe un producto con ese código. Ingrese otro código.";
            return;
        }

        if (string.IsNullOrWhiteSpace(nombre))
        {
            mensaje = "Debe ingresar el nombre del producto.";
            return;
        }

        if (precioBase <= 0)
        {
            mensaje = "El precio base debe ser mayor que cero.";
            return;
        }

        if (tipoProducto == "Bebida")
        {
            if (volumenMl <= 0)
            {
                mensaje = "El volumen de la bebida debe ser mayor que cero.";
                return;
            }

            if (string.IsNullOrWhiteSpace(tipoBebida))
            {
                mensaje = "Debe seleccionar el tipo de bebida.";
                return;
            }

            Bebida nuevaBebida = new Bebida(codigo, nombre, precioBase, volumenMl, tipoBebida);

            ProductoService.AgregarProducto(nuevaBebida);
        }
        else if (tipoProducto == "PlatoFuerte")
        {
            if (string.IsNullOrWhiteSpace(tipoCarne))
            {
                mensaje = "Debe seleccionar el tipo de carne.";
                return;
            }

            if (string.IsNullOrWhiteSpace(acompanamiento))
            {
                mensaje = "Debe seleccionar el acompañamiento.";
                return;
            }

            PlatoFuerte nuevoPlato = new PlatoFuerte(codigo, nombre, precioBase, tipoCarne, acompanamiento);

            ProductoService.AgregarProducto(nuevoPlato);
        }
        else if (tipoProducto == "Postre")
        {
            if (string.IsNullOrWhiteSpace(porcion))
            {
                mensaje = "Debe seleccionar la porción del postre.";
                return;
            }

            Postre nuevoPostre = new Postre(codigo, nombre, precioBase, contieneAzucar, porcion);

            ProductoService.AgregarProducto(nuevoPostre);
        }

        mensaje = "Producto guardado correctamente.";

        LimpiarFormulario();
        CargarListado();
    }

    void BuscarProductos()
    {
        mensaje = "";
        mensajeBusqueda = "";

        productosMostrados = ProductoService.BuscarProductos(criterioBusqueda, textoBusqueda);

        if (productosMostrados.Count == 0)
        {
            mensajeBusqueda = "No se encontraron productos con ese criterio de búsqueda.";
        }
        else
        {
            mensajeBusqueda = $"Se encontraron {productosMostrados.Count} producto(s).";
        }

        totalProductos = ProductoService.ObtenerTotalProductos();
    }

    void MostrarTodos()
    {
        criterioBusqueda = "Todos";
        textoBusqueda = "";
        mensajeBusqueda = "";
        CargarListado();
    }

    void CargarListado()
    {
        productosMostrados = ProductoService.ObtenerProductos();
        totalProductos = ProductoService.ObtenerTotalProductos();
    }

    void LimpiarFormulario()
    {
        tipoProducto = "";

        codigo = "";
        nombre = "";
        precioBase = 0;

        volumenMl = 0;
        tipoBebida = "";

        tipoCarne = "";
        acompanamiento = "";

        contieneAzucar = false;
        porcion = "";
    }

    string ObtenerTipo(Producto producto)
    {
        if (producto is Bebida)
        {
            return "Bebida";
        }

        if (producto is PlatoFuerte)
        {
            return "Plato fuerte";
        }

        if (producto is Postre)
        {
            return "Postre";
        }

        return "Producto";
    }

    string ObtenerDatosEspecificos(Producto producto)
    {
        if (producto is Bebida bebida)
        {
            return $"Volumen: {bebida.VolumenMl} ml, Tipo: {bebida.Tipo}";
        }

        if (producto is PlatoFuerte plato)
        {
            return $"Carne: {plato.TipoCarne}, Acompañamiento: {plato.Acompanamiento}";
        }

        if (producto is Postre postre)
        {
            string azucarTexto = postre.ContieneAzucar ? "Sí contiene azúcar" : "No contiene azúcar";
            return $"{azucarTexto}, Porción: {postre.Porcion}";
        }

        return "Sin datos específicos";
    }
}
